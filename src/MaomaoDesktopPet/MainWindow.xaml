<Window x:Class="MaomaoDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="毛毛"
        Width="220"
        Height="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove"
        MouseRightButtonUp="Window_MouseRightButtonUp"
        MouseEnter="Window_MouseEnter">
    <Grid>
        <Border x:Name="StatusChip"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="4,0,4,0"
                Padding="8,3"
                CornerRadius="10"
                Background="#CCFFFFFF"
                BorderBrush="#66A0C4"
                BorderThickness="1">
            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       Foreground="#445566"
                       Text="Lv.1" />
        </Border>

        <Border x:Name="BubbleBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="8,26,8,0"
                Padding="10,6"
                CornerRadius="12"
                Background="#F2FFFFFF"
                BorderBrush="#66A0C4"
                BorderThickness="1"
                Visibility="Collapsed"
                Cursor="Hand"
                MouseLeftButtonUp="Bubble_MouseLeftButtonUp">
            <TextBlock x:Name="BubbleText"
                       FontSize="13"
                       Foreground="#334455"
                       TextWrapping="Wrap"
                       MaxWidth="180"
                       TextAlignment="Center" />
        </Border>

        <Image x:Name="PetImage"
               Width="200"
               Height="200"
               Margin="0,56,0,0"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               HorizontalAlignment="Center"
               VerticalAlignment="Top" />
    </Grid>
</Window>
